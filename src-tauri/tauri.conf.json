{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Earshot",
  "version": "0.1.0",
  "identifier": "app.earshot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:audio && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Earshot",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/earshot-audio"
    ],
    "category": "Productivity",
    "shortDescription": "Live call copilot",
    "macOS": {
      "minimumSystemVersion": "26.0"
    }
  }
}